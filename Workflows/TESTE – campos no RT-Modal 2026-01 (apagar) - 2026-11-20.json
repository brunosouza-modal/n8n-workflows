s[k] = { ...v, value: '' }; novos.push(k); }\n}\nreturn [{ json: { metadata: JSON.stringify(m), novos, antes } }];\n"},"name":"Acrescentar campos","type":"n8n-nodes-base.code","typeVersion":2,"position":[660,0],"id":"5b16b58d-5016-4cac-a7b0-ed23acf87f2e"},{"parameters":{"url":"http://modal-elabftw-app:8080/api/v2/items/7","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","options":{},"method":"PATCH","sendBody":true,"specifyBody":"json","jsonBody":"={{ JSON.stringify({ metadata: $json.metadata }) }}"},"name":"Gravar","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[880,0],"credentials":{"httpHeaderAuth":{"id":"E1GGjAdh1lMziBUi","name":"Modal - eLabFTW"}},"id":"34f9bcb2-c808-431e-aefa-a9f464acfaa5"},{"parameters":{"url":"http://modal-elabftw-app:8080/api/v2/items/7","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","options":{}},"name":"Conferir","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[1100,0],"credentials":{"httpHeaderAuth":{"id":"E1GGjAdh1lMziBUi","name":"Modal - eLabFTW"}},"id":"c1c057fc-8389-41ad-bcb3-a615576b0ce0"}],"connections":{"Manual":{"main":[[{"node":"Ler produto","type":"main","index":0}]]},"Ler produto":{"main":[[{"node":"Ler modelo","type":"main","index":0}]]},"Ler modelo":{"main":[[{"node":"Acrescentar campos","type":"main","index":0}]]},"Acrescentar campos":{"main":[[{"node":"Gravar","type":"main","index":0}]]},"Gravar":{"main":[[{"node":"Conferir","type":"main","index":0}]]}},"nodeGroups":[],"settings":{"executionOrder":"v1"},"staticData":null,"pinData":{},"meta":null,"tags":[],"shared":[{"role":"workflow:owner","workflowId":"testeCamposRT","projectId":"dOg1kukijbsds31a","createdAt":"2026-11-20T20:13:05.225Z","updatedAt":"2026-11-20T20:13:05.225Z"}],"activeVersion":null,"totalWorkflows":37,"yesterdayDate":"2026-11-20T05:00:28.199Z"}