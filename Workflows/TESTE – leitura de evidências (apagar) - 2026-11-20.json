ustom_id: x.custom_id, created_at: x.created_at,\n  metadata: x.metadata, items_links: (x.items_links||[]).map(l => ({entityid: l.entityid, title: l.title, cat: l.category_title})),\n  related_items_links: (x.related_items_links||[]).map(l => ({entityid: l.entityid, title: l.title, cat: l.category_title})),\n  experiments_links: (x.experiments_links||[]).map(l => ({entityid: l.entityid, cat: l.category_title})),\n  related_experiments_links: (x.related_experiments_links||[]).map(l => ({entityid: l.entityid, cat: l.category_title})),\n  keys: Object.keys(x).join(',') }));\nreturn [{ json: { resumo: JSON.stringify({ tipos, itens }) } }];\n"},"name":"Resumo","type":"n8n-nodes-base.code","typeVersion":2,"position":[880,0],"executeOnce":true,"id":"63459de0-6e99-4b13-8b89-794f8e51fe4e"}],"connections":{"Manual":{"main":[[{"node":"Tipos","type":"main","index":0}]]},"Tipos":{"main":[[{"node":"Lista","type":"main","index":0}]]},"Lista":{"main":[[{"node":"Ler completo","type":"main","index":0}]]},"Ler completo":{"main":[[{"node":"Resumo","type":"main","index":0}]]}},"nodeGroups":[],"settings":{"executionOrder":"v1","saveManualExecutions":true},"staticData":null,"pinData":{},"meta":null,"tags":[],"shared":[{"role":"workflow:owner","workflowId":"testeLeituraEvid","projectId":"dOg1kukijbsds31a","createdAt":"2026-11-20T18:40:26.709Z","updatedAt":"2026-11-20T18:40:26.709Z"}],"activeVersion":null,"totalWorkflows":37,"yesterdayDate":"2026-11-20T05:00:28.199Z"}