{"id":"n8nAvisosDeErro","name":"n8n – Avisos de erro","active":true,"activeVersionId":"29e98699-16d6-4eda-a988-403ecd6ddeae","createdAt":"2026-11-20T13:59:05.249Z","updatedAt":"2026-11-20T23:01:30.454Z","isArchived":false,"versionId":"29e98699-16d6-4eda-a988-403ecd6ddeae","triggerCount":0,"nodes":[{"parameters":{},"name":"Erro recebido","type":"n8n-nodes-base.errorTrigger","typeVersion":1,"position":[0,0],"id":"2c0c7b06-77fd-4f1d-ad9c-56fe791a56d7"},{"parameters":{"mode":"raw","jsonOutput":"{\n  \"destinatario\": \"suporte@modal.org.br\",\n  \"remetenteReserva\": \"n8n do Modal <suporte@modal.org.br>\",\n  \"janelaHoras\": 6,\n  \"urlEditor\": \"https://n8n.modal.org.br\"\n}","options":{}},"name":"Configuração","type":"n8n-nodes-base.set","typeVersion":3.4,"position":[220,0],"id":"6e4eadc0-8a5d-433c-b4fd-29a148f6831c"},{"parameters":{"resource":"table","operation":"create","tableName":"n8n_avisos_erro","columns":{"column":[{"name":"fluxo_id","type":"string"},{"name":"fluxo_nome","type":"string"},{"name":"ultimo_aviso","type":"string"},{"name":"pendentes","type":"number"}]},"options":{"createIfNotExists":true}},"name":"Preparar tabela de avisos","type":"n8n-nodes-base.dataTable","typeVersion":1.1,"position":[440,0],"id":"64fdf3a3-b1c0-420b-aa1f-e6b6c6b8c1b7"},{"parameters":{"operation":"get","dataTableId":{"__rl":true,"mode":"name","value":"n8n_avisos_erro"},"returnAll":true},"name":"Ler avisos anteriores","type":"n8n-nodes-base.dataTable","typeVersion":1.1,"position":[660,0],"executeOnce":true,"alwaysOutputData":true,"id":"1ab61c7e-273b-4858-9fe3-4cbcf2d9a0f6"},{"parameters":{"jsCode":"// Lógica do nó \"Decidir aviso\" do fluxo \"n8n – Avisos de erro\".\n// Função pura: recebe o evento do Error Trigger e o registro de avisos e decide entre avisar e só contar.\n\nfunction decidirAvisoErro({ evento, registros, agora, cfg }) {\n  const wf = evento.workflow || {};\n  const ex = evento.execution || {};\n  const gatilho = evento.trigger || {};\n  const fluxoId = String(wf.id ?? 'desconhecido');\n  const fluxoNome = wf.name || fluxoId;\n  const erro = ex.error || gatilho.error || {};\n  const mensagem = erro.message || erro.description || 'Erro sem mensagem';\n  const passo = ex.lastNodeExecuted || (erro.node && erro.node.name) || (gatilho.error ? 'Gatilho do fluxo' : '—');\n  const link = ex.url || (ex.id ? `${cfg.urlEditor}/workflow/${fluxoId}/executions/${ex.id}` : `${cfg.urlEditor}/workflow/${fluxoId}`);\n\n  const reg = registros.find((r) => r && String(r.fluxo_id) === fluxoId);\n  const ultimo = reg && reg.ultimo_aviso ? new Date(reg.ultimo_aviso) : null;\n  const pendentes = (reg && Number(reg.pendentes)) || 0;\n\n  if (ultimo && !Number.isNaN(ultimo.getTime()) && agora - ultimo < cfg.janelaHoras * 3600e3) {\n    return { acao: 'contar', fluxo_id: fluxoId, fluxo_nome: fluxoNome, ultimo_aviso: reg.ultimo_aviso, pendentes: pendentes + 1 };\n  }\n\n  const extra = pendentes > 0\n    ? `Desde o aviso anterior, este fluxo falhou mais ${pendentes} ${pendentes === 1 ? 'vez' : 'vezes'} sem novo e-mail.`\n    : '';\n  const silencio = `Novas falhas deste fluxo nas próximas ${cfg.janelaHoras} horas serão só contadas.`;\n  return {\n    acao: 'avisar',\n    fluxo_id: fluxoId,\n    fluxo_nome: fluxoNome,\n    ultimo_aviso: agora.toISOString(),\n    pendentes: 0,\n    para: cfg.destinatario,\n    nomeRemetente: 'n8n do Modal',\n    assunto: `n8n do Modal: falha no fluxo \"${fluxoNome}\"`,\n    etiqueta: 'n8n · Falha de fluxo',\n    titulo: `O fluxo \"${fluxoNome}\" falhou`,\n    blocos: [\n      { tipo: 'campos', itens: [{ rotulo: 'Fluxo', valor: fluxoNome }, { rotulo: 'Passo', valor: passo }] },\n      { tipo: 'aviso', tom: 'erro', texto: mensagem },\n      ...(extra ? [{ tipo: 'paragrafo', texto: extra }] : []),\n    ],\n    acaoRotulo: 'Ver a execução no n8n',\n    acaoUrl: link,\n    rodape: `${silencio} Aviso automático do n8n do Modal (fluxo \"n8n – Avisos de erro\").`,\n    // Texto puro, usado também no envio de reserva pelo Mailgun se o subfluxo falhar.\n    texto: [\n      `O fluxo \"${fluxoNome}\" falhou.`,\n      `Passo: ${passo}`,\n      `Erro: ${mensagem}`,\n      `Ver a execução: ${link}`,\n      extra,\n      silencio,\n      'Aviso automático do n8n do Modal (fluxo \"n8n – Avisos de erro\").',\n    ].filter(Boolean).join('\\n\\n'),\n  };\n}\n\n\nconst s = decidirAvisoErro({\n  evento: $('Erro recebido').first().json,\n  registros: $('Ler avisos anteriores').all().map((i) => i.json),\n  agora: new Date(),\n  cfg: $('Configuração').first().json,\n});\nreturn [{ json: s }];\n"},"name":"Decidir aviso","type":"n8n-nodes-base.code","typeVersion":2,"position":[880,0],"id":"cacb9c16-5c64-457f-93f9-3d3e60d57d29"},{"parameters":{"conditions":{"options":{"caseSensitive":true,"typeValidation":"strict","version":2},"combinator":"and","conditions":[{"leftValue":"={{ $json.acao }}","rightValue":"avisar","operator":{"type":"string","operation":"equals"}}]},"options":{}},"name":"Avisar agora?","type":"n8n-nodes-base.if","typeVersion":2.2,"position":[1100,0],"id":"c88029be-ff78-423b-8778-c5dc10d11b34"},{"parameters":{"workflowId":{"__rl":true,"mode":"id","value":"modalEnviarEmail"},"workflowInputs":{"mappingMode":"defineBelow","value":{"para":"={{ $json.para }}","cc":"={{ $json.cc }}","cco":"={{ $json.cco }}","responderPara":"={{ $json.responderPara }}","nomeRemetente":"={{ $json.nomeRemetente }}","assunto":"={{ $json.assunto }}","modelo":"={{ $json.modelo }}","etiqueta":"={{ $json.etiqueta }}","titulo":"={{ $json.titulo }}","previa":"={{ $json.previa }}","blocos":"={{ $json.blocos }}","corpoHtml":"={{ $json.corpoHtml }}","acaoRotulo":"={{ $json.acaoRotulo }}","acaoUrl":"={{ $json.acaoUrl }}","rodape":"={{ $json.rodape }}","texto":"={{ $json.texto }}","anexos":"={{ $json.anexos }}"},"matchingColumns":[],"schema":[{"id":"para","displayName":"para","required":false,"defaultMatch":false,"display":true,"canBeUsedToMatch":true,"type":"string","removed":false},{"id":"cc","displayName":"cc","required":false,